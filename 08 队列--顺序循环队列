//FIFO---First In First Out
#include<iostream>
#include<new>
using namespace std;

#define MAXQSIZE 100 //最大队列长度
typedef int QElemType ; 
typedef struct{
    QElemType* base;
    int front; //头部下标
    int rear; //尾部下标,指向下一个没有元素的部分
}SqQueue;
//需要两个“指针”确定内部哪里有元素

//初始化
bool InitQueue(SqQueue &Q){
    try {
        Q.base = new QElemType[MAXQSIZE];
    } catch(const std::bad_alloc&){
        Q.base = nullptr;
        Q.front = Q.rear = 0;
        return false;
    }
    Q.front = Q.rear = 0;//哦哦，还能这样连等啊
    return true;
}

